{
  "lexicon": 1,
  "id": "xyz.statusphere.getStatuses",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["statuses"],
          "properties": {
            "cursor": { "type": "string" },
            "statuses": {
              "type": "array",
              "items": { "type": "ref", "ref": "xyz.statusphere.status#statusView" }
            }
          }
        }
      }
    }
  }
}
